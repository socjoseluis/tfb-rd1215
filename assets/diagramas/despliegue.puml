@startuml despliegue
' Diagrama de DESPLIEGUE en notación UML (PlantUML).
' Transcripción de assets/diagramas/despliegue.mmd: mismos nodos y mismas
' comunicaciones definidas por el autor; solo cambia la notación. Los grupos
' pasan a ser nodos UML con su estereotipo.
' Trazado con Graphviz (dot). Sin Graphviz, descomentar para el motor interno.
' !pragma layout smetana

skinparam backgroundColor transparent
skinparam shadowing false
skinparam defaultFontSize 13
skinparam ArrowColor #333333
skinparam NodeBackgroundColor #FDFDFD
skinparam NodeBorderColor #555555

node "Dispositivo cliente" <<device>> as cliente {
  [Navegador web\nescritorio o móvil] as navegador
}

node "Servidor de aplicación" <<device>> as servidor {
  node "Django 5.2.16 LTS\nservidor de desarrollo\nPython 3.12" <<execution environment>> as django
  artifact "Ficheros estáticos\nBootstrap 5.3.3" as estaticos
  ' La base de datos va DENTRO del servidor, no en un nodo aparte: SQLite es un
  ' fichero en el disco de esa misma máquina, no un equipo distinto. Dibujarla
  ' fuera sugería un tercer nodo de hardware que no existe, y además obligaba a
  ' la flecha a entrar por el borde superior del nodo, justo donde va su
  ' rótulo, que quedaba atravesado.
  database "SQLite\nfichero local" as base
}

navegador --> django : HTTP · red local
navegador --> estaticos : HTTP · red local
django --> base : acceso a fichero

@enduml
