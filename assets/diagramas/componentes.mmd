%%{init: {'themeCSS': '#my-svg-dominio .cluster-label { translate: -290px 64px !important; }'}}%%
%% El título del subgraph "dominio" se reubica en el margen izquierdo de la
%% caja, centrado verticalmente, a la izquierda del nodo models.py (zona vacía).
%% Así ninguna flecha lo cruza: las de views/forms entran a models por arriba y
%% el título queda por debajo; en el borde superior (posición por defecto) lo
%% cruzaban importador/admin -> models. Se usa la propiedad CSS "translate" (no
%% "transform") porque se compone con la posición original: X=-290 lo lleva al
%% margen izquierdo, Y=+64 lo baja al centro vertical de la caja.
%% AVISO: el id "my-svg-dominio" y los desplazamientos dependen del layout
%% actual. Si se cambia el diagrama y se regenera, comprobar que el título sigue
%% encajado en el margen y reajustar los valores si hiciera falta.
flowchart TB
    subgraph cliente["Cliente"]
        navegador["Navegador<br/>escritorio o móvil"]
    end

    subgraph aplicacion["Capa de lógica de aplicación"]
        enrutado["urls.py<br/>enrutado"]
        vistas["views.py<br/>8 vistas · formset<br/>de respuestas"]
        formularios["forms.py<br/>2 formularios<br/>(ModelForm)"]
        importador["importador.py<br/>openpyxl · csv"]
        admin["Admin de Django<br/>trastienda"]
    end

    subgraph presentacion["Capa de presentación"]
        plantillas["Plantillas Django<br/>base.html + 8 páginas"]
        bootstrap["Bootstrap 5.3.3<br/>servido en local"]
    end

    subgraph dominio["Capa de dominio"]
        modelos["models.py<br/>7 modelos y reglas<br/>del Anexo I.2"]
        criterios["criterios_rd1215.json<br/>11 grupos · 33 criterios"]
    end

    subgraph persistencia["Capa de persistencia"]
        orm["ORM de Django"]
        sqlite[("SQLite")]
    end

    subgraph configuracion["Configuración"]
        config["config<br/>settings · python-decouple"]
    end

    navegador -- "HTTP" --> enrutado

    enrutado --> vistas
    vistas --> formularios
    vistas --> importador
    vistas --> plantillas
    vistas --> modelos
    formularios --> modelos
    importador --> modelos
    admin --> modelos
    plantillas --> bootstrap

    modelos --> orm
    criterios -- "loaddata" --> orm
    orm --> sqlite

    config -.-> vistas
    config -.-> orm
