SECRET_KEY=your-secret-key-here
DEBUG=True
# Nombres o IPs desde los que se sirve la aplicacion, separados por comas.
ALLOWED_HOSTS=localhost,127.0.0.1
# Origenes de confianza para POST. Solo necesario tras un proxy o tunel HTTPS.
